<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>Preview</LangVersion>
	  <Authors>DMG</Authors>
	  <Company>Cygnus Instruments Ltd</Company>
	  <Product>TM-Link</Product>
	  <Description>InTheHand implementations for BLE Connected Cygnus Gauges</Description>
	  <PackageId>Cygnus.BLE.InTheHand</PackageId>
	  <Title>Cygnus.BLE.InTheHand</Title>
	  <Copyright>© 2026 Cygnus Instruments Ltd</Copyright>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <!--Auto-generate NuGet package-->
	  <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <RepositoryUrl>https://github.com/c49nu5/tmlink-dotnet-api</RepositoryUrl>
	  <PackageIcon>icon.png</PackageIcon>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
	  <None Include="..\icon.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\LICENSE.txt">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
	  </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
	<PackageReference Include="InTheHand.BluetoothLE" Version="4.0.44" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cygnus.BLE.Interfaces\Cygnus.BLE.Interfaces.csproj" />
  </ItemGroup>

</Project>
