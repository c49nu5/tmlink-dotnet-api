<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>Preview</LangVersion>

		<Authors>DMG</Authors>
		<Company>Cygnus Instruments Ltd</Company>
		<Product>TM-Link</Product>
		<Description>Interfaces for Cygnus Gauges</Description>
		<PackageId>Cygnus.Interfaces</PackageId>
		<Title>Cygnus.Interfaces</Title>
		<Copyright>© 2026 Cygnus Instruments Ltd</Copyright>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<!--Auto-generate NuGet package-->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<RepositoryUrl>https://github.com/c49nu5/tmlink-dotnet-api</RepositoryUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\Cygnus.Models\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Cygnus.Models\Cygnus.Models.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="README.md">
	    <PackagePath>\</PackagePath>
	    <Pack>True</Pack>
	  </None>
	</ItemGroup>

</Project>
